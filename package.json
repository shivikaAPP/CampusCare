{
  "name": "campuscare-suite",
  "version": "1.0.0",
  "description": "CampusCare - Smart Campus Complaint Management System",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently -n \"backend,frontend\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "test:backend": "npm --prefix backend test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
